# Configuração por ambiente (DEVOPS-004).
# Copie para .env.local. Nada aqui é segredo: tudo entra no bundle e é público.

# Modo demonstração (padrão: ligado). "false" desliga a faixa de aviso e passa a
# exibir dados de empresa reais — só faça isso com conteúdo jurídico revisado.
VITE_DEMO_MODE=true

# Canais de atendimento. Vazio = o canal não aparece na interface.
VITE_WHATSAPP_URL=
VITE_CONTACT_EMAIL=
VITE_PRESS_EMAIL=
VITE_PRIVACY_EMAIL=

# Endpoint que recebe o formulário de contato. Vazio = formulário desativado.
VITE_CONTACT_FORM_ENDPOINT=

# Dados da empresa exibidos no rodapé quando VITE_DEMO_MODE=false.
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_CNPJ=

# Origem das fotos dos lotes.
# Vazio: banco de imagens externo (uma requisição a terceiro por carregamento).
# Para carregar sem terceiros: rode `npm run fotos:baixar` e descomente a linha.
# VITE_PHOTO_BASE=/fotos

# Relato de erro e funil (DEVOPS-002). Vazio = nada sai da máquina.
# Endpoint externo exige liberar o host em `connect-src` na CSP
# (public/_headers e vercel.json).
VITE_ERROR_ENDPOINT=
VITE_ANALYTICS_ENDPOINT=
# Identifica a versão nos relatos de erro (ex.: o SHA do commit no deploy).
VITE_RELEASE=

# API. Vazio = modo demonstração (tudo no navegador, sem back-end).
# "/" = mesma origem, servida pelo próprio `npm run servidor`.
# Uma URL = API noutro domínio (libere o host em connect-src na CSP).
VITE_API_URL=

# Caminho do banco SQLite do servidor.
# LEILOAE_DB=./dados/leiloae.db

# --- Servidor ---------------------------------------------------------------
# Caminho do banco SQLite.
# LEILOAE_DB=./dados/leiloae.db

# Origem pública, usada para montar os links de e-mail (recuperação de senha e
# confirmação de endereço).
# LEILOAE_URL_BASE=https://leiloae.exemplo.br

# Confiar em X-Forwarded-For para identificar o cliente na limitação de taxa.
# Ligue APENAS se houver um proxy reverso confiável na frente — senão o próprio
# atacante escolhe a chave do limite dele.
# LEILOAE_ATRAS_DE_PROXY=1

# Limites de taxa, no formato capacidade:porMinuto. Ver docs/api.md.
# LEILOAE_LIMITE_AUTENTICACAO=10:1
# LEILOAE_LIMITE_ESCRITA=30:60
# LEILOAE_LIMITE_LEITURA=120:240

# Webhook que entrega e-mails transacionais (recuperação de senha e confirmação
# de endereço). Sem ele, a recuperação responde "canal indisponível" em
# produção; fora de produção, o e-mail é impresso no log do servidor.
# LEILOAE_EMAIL_ENDPOINT=

# --- Cópia de segurança (scripts/backup.mjs) --------------------------------
# Pasta de destino e política de retenção. O mínimo por contagem existe para
# que um relógio errado não consiga apagar todas as cópias de uma vez.
# LEILOAE_BACKUP_DIR=./backups
# LEILOAE_BACKUP_DIAS=30
# LEILOAE_BACKUP_MINIMO=7

